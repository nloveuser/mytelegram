# MyTelegram Bot Server (Telegram Bot API front-end).

# This stage is used when running from VS in fast mode (Default for Debug configuration)
FROM --platform=$TARGETARCH mcr.microsoft.com/dotnet/aspnet:10.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# This stage is used to build the service project
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
ARG TARGETARCH
WORKDIR /src
COPY ["Directory.Packages.props", "."]
COPY ["Directory.Build.props", "."]
COPY ["nuget.config", "."]
COPY ["src/MyTelegram.BotServer/MyTelegram.BotServer.csproj", "src/MyTelegram.BotServer/"]

RUN dotnet restore -a $TARGETARCH "./src/MyTelegram.BotServer/MyTelegram.BotServer.csproj"
COPY . .
WORKDIR "/src/src/MyTelegram.BotServer"
RUN dotnet build "./MyTelegram.BotServer.csproj" -a $TARGETARCH -c $BUILD_CONFIGURATION -o /app/build

# This stage is used to publish the service project to be copied to the final stage
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
ARG TARGETARCH
RUN dotnet publish "./MyTelegram.BotServer.csproj" -a $TARGETARCH -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# This stage is used in production or when running from VS in regular mode (Default when not using the Debug configuration)
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "MyTelegram.BotServer.dll"]
